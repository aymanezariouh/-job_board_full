<%- include('partials/header') %>

<section class="search-section">
  <h1>Trouvez votre stage ou alternance</h1>
  <form action="/" method="GET" class="filter-form">
    <div class="form-group">
      <input 
        type="text" 
        name="search" 
        placeholder="Mot-clé (titre, entreprise...)" 
        value="<%= filters.search || '' %>"
      >
    </div>

    <div class="form-group">
      <select name="ville">
        <option value="">Toutes les villes</option>
        <% villes.forEach(function(v) { %>
          <option value="<%= v %>" <%= filters.ville === v ? 'selected' : '' %>><%= v %></option>
        <% }); %>
      </select>
    </div>

    <div class="form-group">
      <select name="type_contrat">
        <option value="">Tous les contrats</option>
        <option value="Stage" <%= filters.type_contrat === 'Stage' ? 'selected' : '' %>>Stage</option>
        <option value="Alternance" <%= filters.type_contrat === 'Alternance' ? 'selected' : '' %>>Alternance</option>
      </select>
    </div>

    <div class="form-group">
      <select name="technologie">
        <option value="">Toutes les technologies</option>
        <% technologies.forEach(function(t) { %>
          <option value="<%= t.nom %>" <%= filters.technologie === t.nom ? 'selected' : '' %>><%= t.nom %></option>
        <% }); %>
      </select>
    </div>

    <div class="form-group">
      <select name="tri">
        <option value="desc" <%= filters.tri !== 'asc' ? 'selected' : '' %>>Plus récentes</option>
        <option value="asc" <%= filters.tri === 'asc' ? 'selected' : '' %>>Plus anciennes</option>
      </select>
    </div>

    <button type="submit" class="btn">Filtrer</button>
    <a href="/" class="btn btn-secondary">Réinitialiser</a>
  </form>
</section>

<section class="offers-section">
  <h2>Offres disponibles (<%= offres.length %>)</h2>

  <% if (offres.length === 0) { %>
    <p class="no-results">Aucune offre ne correspond à vos critères de recherche.</p>
  <% } else { %>
    <div class="offers-grid">
      <% offres.forEach(function(offre) { %>
        <article class="card-offre">
          <div class="card-header">
            <span class="badge badge-<%= offre.type_contrat.toLowerCase() %>"><%= offre.type_contrat %></span>
            <button class="btn-suivi" data-id="<%= offre.id %>" title="Suivre cette offre">★</button>
          </div>
          <h3><%= offre.titre %></h3>
          <p class="company"><%= offre.entreprise_nom %> — <strong><%= offre.ville %></strong></p>
          <p class="desc"><%= offre.description_courte %></p>
          
          <% if (offre.technologies) { %>
            <div class="tech-tags">
              <% offre.technologies.split(', ').forEach(function(tech) { %>
                <span class="tag"><%= tech %></span>
              <% }); %>
            </div>
          <% } %>

          <div class="card-footer">
            <small>Publiée le <%= new Date(offre.date_publication).toLocaleDateString('fr-FR') %></small>
            <a href="/offres/<%= offre.id %>" class="btn-link">Voir l'offre &rarr;</a>
          </div>
        </article>
      <% }); %>
    </div>
  <% } %>
</section>

<%- include('partials/footer') %>
