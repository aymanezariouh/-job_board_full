<%- include('partials/header') %>

<main class="page-space">
  <div class="container">
    <span class="eyebrow">♧ VOS OFFRES FAVORITES</span>
    <h1>Offres suivies</h1>
    <p class="muted">Retrouvez ici les offres que vous avez marquées avec l'étoile ★ sur ce navigateur.</p>

    <div class="offer-summary">
      <div class="offer-summary-left">
        <h2 id="suivi-count">0 offres suivies</h2>
        <span class="summary-chip">
          <span class="status-dot"></span>
          Sauvegardées localement
        </span>
      </div>
    </div>

    <div id="no-suivi-msg" class="empty-box" style="display:none;">
      <div class="empty-inner">
        <div class="empty-icon">♧</div>
        <h2>Aucune offre suivie</h2>
        <p class="muted">
          Cliquez sur l'étoile ★ d'une offre pour la retrouver ici.
        </p>
        <a class="btn btn-primary" href="/">Parcourir les offres</a>
      </div>
    </div>

    <div class="jobs-grid" id="suivi-grid">
      <% offres.forEach(function(offre) { 
           const contractClass = offre.type_contrat === "Stage" ? "badge-stage" : "badge-alternance";
           const initials = offre.entreprise_nom ? offre.entreprise_nom.split(" ").map(w => w[0]).join("").toUpperCase() : "ENT";
      %>
        <article class="card job-card suivi-card" data-id="<%= offre.id %>" style="display:none;">
          <div class="job-head">
            <div class="job-title-wrap">
              <div class="logo-box"><%= initials %></div>
              <div>
                <h3><%= offre.titre %></h3>
                <div class="company-line"><%= offre.entreprise_nom %> • <%= offre.ville %></div>
              </div>
            </div>
            <div style="display:flex; align-items:center; gap:10px;">
              <button class="btn-suivi" data-id="<%= offre.id %>" title="Ne plus suivre">★</button>
              <span class="badge badge-contract <%= contractClass %>"><%= offre.type_contrat %></span>
            </div>
          </div>

          <p class="job-description"><%= offre.description_courte %></p>

          <div class="badges">
            <% if (offre.technologies) { %>
              <% offre.technologies.split(', ').forEach(function(tech) { %>
                <span class="badge"><%= tech %></span>
              <% }); %>
            <% } %>
          </div>

          <div class="job-footer">
            <div class="job-date"><%= new Date(offre.date_publication).toLocaleDateString('fr-FR') %></div>
            <div class="job-actions">
              <a class="btn btn-primary" href="/offres/<%= offre.id %>">Voir l'offre →</a>
            </div>
          </div>
        </article>
      <% }); %>
    </div>
  </div>
</main>

<script>
  // Show only the cards that are in localStorage
  document.addEventListener("DOMContentLoaded", function () {
    var saved = localStorage.getItem("followed_job_offers");
    var ids = saved ? JSON.parse(saved) : [];
    var count = 0;

    document.querySelectorAll(".suivi-card").forEach(function (card) {
      var cardId = Number(card.getAttribute("data-id"));
      if (ids.includes(cardId)) {
        card.style.display = "";
        count++;
      }
    });

    document.getElementById("suivi-count").textContent = count + " offre" + (count !== 1 ? "s" : "") + " suivie" + (count !== 1 ? "s" : "");

    if (count === 0) {
      document.getElementById("no-suivi-msg").style.display = "";
    }

    // When a star is unclicked on this page, hide the card
    document.getElementById("suivi-grid").addEventListener("click", function (e) {
      var btn = e.target.closest(".btn-suivi");
      if (!btn) return;

      var id = Number(btn.getAttribute("data-id"));
      var card = btn.closest(".suivi-card");

      // Small delay so the user sees the visual feedback from suivi.js
      setTimeout(function () {
        var updatedSaved = localStorage.getItem("followed_job_offers");
        var updatedIds = updatedSaved ? JSON.parse(updatedSaved) : [];

        if (!updatedIds.includes(id) && card) {
          card.style.display = "none";
          count--;
          document.getElementById("suivi-count").textContent = count + " offre" + (count !== 1 ? "s" : "") + " suivie" + (count !== 1 ? "s" : "");
          if (count === 0) {
            document.getElementById("no-suivi-msg").style.display = "";
          }
        }
      }, 100);
    });
  });
</script>

<%- include('partials/footer') %>